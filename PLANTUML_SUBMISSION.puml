' --------------------------------------------------------------------------------------
' 1.1 BIỂU ĐỒ USE CASE TỔNG QUAN HỆ THỐNG (BẢN TIẾNG ANH - ĐỒNG BỘ VISUAL PARADIGM)
' --------------------------------------------------------------------------------------
@startuml General_UseCase_GaraMan
skinparam packageStyle rectangle
skinparam shadowing false
left to right direction

actor "Member" as Member
actor "Customer" as Customer
actor "Staff" as Staff
actor "Sales Staff" as SalesStaff
actor "Manager" as Manager
actor "Warehouse Staff" as WarehouseStaff

Member <|-- Customer
Member <|-- Staff
Staff <|-- SalesStaff
Staff <|-- Manager
Staff <|-- WarehouseStaff

rectangle "GaraMan" {
    usecase "Login" as UC_Login
    usecase "Logout" as UC_Logout
    usecase "Change Password" as UC_ChangePassword

    usecase "Search Services and Parts" as UC_Search
    usecase "Book Online Appointment" as UC_Book

    usecase "Receive Customer" as UC_ReceiveCustomer
    usecase "Receive Service and Part Request" as UC_ReceiveRequest
    usecase "Assign Technician" as UC_AssignTech
    usecase "Receive Payment" as UC_Payment

    usecase "Manage Services" as UC_ManageServices
    usecase "Manage Parts" as UC_ManageParts
    usecase "View Statistic Reports" as UC_ViewReports

    usecase "Manage Suppliers" as UC_ManageSuppliers
    usecase "Import Parts" as UC_ImportParts
}

Member --> UC_Login
Member --> UC_Logout
Member --> UC_ChangePassword

Customer --> UC_Search
Customer --> UC_Book

SalesStaff --> UC_ReceiveCustomer
SalesStaff --> UC_ReceiveRequest
SalesStaff --> UC_AssignTech
SalesStaff --> UC_Payment

Manager --> UC_ManageServices
Manager --> UC_ManageParts
Manager --> UC_ViewReports

WarehouseStaff --> UC_ManageSuppliers
WarehouseStaff --> UC_ImportParts

@enduml


' --------------------------------------------------------------------------------------
' 1.2 BIỂU ĐỒ USE CASE CHI TIẾT - MODULE 1: KHÁCH HÀNG TÌM KIẾM DỊCH VỤ / PHỤ TÙNG
' (Đồng bộ 100% với bản vẽ Visual Paradigm của sinh viên)
' --------------------------------------------------------------------------------------
@startuml Detailed_UC_Module1_Search
skinparam packageStyle rectangle
skinparam shadowing false
left to right direction

actor "Customer" as Customer

rectangle "Search Service Info" {
    usecase "Search Service Info" as UC_Search
    usecase "Display Result List" as UC_DisplayList
    usecase "View Service and Part Details" as UC_ViewDetails
}

Customer --> UC_Search

UC_Search ..> UC_DisplayList : <<include>>
UC_ViewDetails ..> UC_DisplayList : <<extend>>

@enduml


' --------------------------------------------------------------------------------------
' 1.3 BIỂU ĐỒ USE CASE CHI TIẾT - MODULE 2: NHÂN VIÊN KHO NHẬP PHỤ TÙNG TỪ NHÀ CUNG CẤP
' (Đồng bộ 100% với bản vẽ Visual Paradigm của sinh viên - Đã loại bỏ số 8)
' --------------------------------------------------------------------------------------
@startuml Detailed_UC_Module2_Import
skinparam packageStyle rectangle
skinparam shadowing false
left to right direction

actor "Warehouse Staff" as WarehouseStaff

rectangle "Import Parts" {
    usecase "Import Parts" as UC_ImportParts
    usecase "Search and Select Supplier" as UC_SelectSupplier
    usecase "Add New Supplier" as UC_AddSupplier
    usecase "Search and Select Part" as UC_SelectPart
    usecase "Add New Part" as UC_AddPart
    usecase "Input Quantity and Unit Price" as UC_InputQtyPrice
    usecase "Confirm Import Invoice" as UC_ConfirmInvoice
    usecase "Print Import Invoice" as UC_PrintInvoice
}

WarehouseStaff --> UC_ImportParts

UC_ImportParts ..> UC_SelectSupplier : <<include>>
UC_AddSupplier ..> UC_SelectSupplier : <<extend>>

UC_ImportParts ..> UC_SelectPart : <<include>>
UC_AddPart ..> UC_SelectPart : <<extend>>

UC_ImportParts ..> UC_InputQtyPrice : <<include>>
UC_ImportParts ..> UC_ConfirmInvoice : <<include>>
UC_ImportParts ..> UC_PrintInvoice : <<include>>

@enduml

